# Copia questo file e rinominalo in .env
# Inserisci le tue chiavi personali

FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=inserisci_la_tua_chiave_freellmapi
FREELLMAPI_MODEL=auto:fastest

GEMINI_API_KEY=inserisci_la_tua_chiave_gemini
# Modello unico: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# Timeout delle chiamate LLM in secondi
LLM_TIMEOUT_SECONDS=20
# Attesa tra i retry su 503/429 (secondi)
LLM_RETRY_DELAY_SECONDS=1.5

# Origini autorizzate per il frontend (CORS), separate da virgola
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
