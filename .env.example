# Copia questo file e rinominalo in .env
# Inserisci le tue chiavi personali

FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=inserisci_la_tua_chiave_freellmapi
FREELLMAPI_MODEL=auto:fastest
# Timeout corto: se FreeLLMAPI non risponde, si passa subito a Gemini
FREELLMAPI_TIMEOUT_SECONDS=3

GEMINI_API_KEY=inserisci_la_tua_chiave_gemini
# Modello unico: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
# Timeout del singolo tentativo (i 2 retry su 503/429 restano)
GEMINI_TIMEOUT_SECONDS=6

# Terza e ultima risorsa: servizio a pagamento, quindi timeout più lungo
DEEPSEEK_API_KEY=inserisci_la_tua_chiave_deepseek
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=30

# Attesa tra i retry su 503/429 (secondi)
LLM_RETRY_DELAY_SECONDS=1.5

# Origini autorizzate per il frontend (CORS), separate da virgola
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Database Supabase (Collega 1): solo lato server
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=segnaposto

# Auth nickname+PIN (Collega 1): JWT breve, sub=user_id, TTL 24h
JWT_SECRET=segnaposto
JWT_TTL_SECONDI=86400
